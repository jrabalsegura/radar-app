# Solo el worker puede leer esta variable. No uses una clave real en este archivo.
AEMET_API_KEY=replace-with-your-own-key
AEMET_POLL_INTERVAL_SECONDS=300
AEMET_RETRY_ATTEMPTS=3
AEMET_RETRY_BACKOFF_SECONDS=1
AEMET_RETENTION_HOURS=24
AEMET_HISTORY_HOURS=3
AEMET_PRODUCT_DELAY_SECONDS=1

# Estilo público de depuración. Puede sustituirse sin recompilar el código.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
